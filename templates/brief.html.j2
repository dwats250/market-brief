<!doctype html>
<html lang="en" data-session-date="{{ session.date }}" data-checkpoint="{{ marker_checkpoint }}"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'unsafe-inline'; script-src 'unsafe-inline'; base-uri 'none'; form-action 'none'">
<title>{{ banner.title }} · Market Brief</title>
<style>
:root{color-scheme:light dark;--paper:#f6f3ec;--ink:#242e2a;--muted:#627168;--faint:#8a968f;--teal:#205e52;--line:#d8ddd3;--rule:#e6e9e2;--amber:#84551a;--notice:#eee6d7;--positive:#2e7654;--negative:#a24942;--neutral:#65736e}
html[data-theme="dark"]{--paper:#20282a;--ink:#f2eadc;--muted:#aab6b1;--faint:#7f8b87;--teal:#66c7bd;--line:#3d4b4d;--rule:#2f3b3d;--amber:#e1b66d;--notice:#353535;--positive:#7bc994;--negative:#e18179;--neutral:#aab6b1}
@media(prefers-color-scheme:dark){html:not([data-theme]){--paper:#20282a;--ink:#f2eadc;--muted:#aab6b1;--faint:#7f8b87;--teal:#66c7bd;--line:#3d4b4d;--rule:#2f3b3d;--amber:#e1b66d;--notice:#353535;--positive:#7bc994;--negative:#e18179;--neutral:#aab6b1}}
*{box-sizing:border-box}body{margin:0;background:var(--paper);color:var(--ink);font:17px/1.6 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif}
main{max-width:1000px;margin:auto;padding:36px 54px 54px}a{color:var(--teal);text-underline-offset:3px;overflow-wrap:anywhere}
p,.para,.dek,.read,.watch,.flags,.events,.since ul{max-width:700px}
.masthead{display:flex;justify-content:space-between;align-items:baseline;border-top:4px solid var(--teal);padding-top:12px;font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--muted)}
.masthead-title{font-weight:750;color:var(--teal)}
.status-line{font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);font-weight:600;margin-top:12px;overflow-wrap:anywhere}
h1{font:500 52px/1.05 Georgia,"Iowan Old Style",Charter,"Times New Roman",serif;letter-spacing:-.02em;max-width:780px;margin:20px 0 18px;overflow-wrap:anywhere;text-wrap:balance}
h2{font:600 24px/1.2 Georgia,"Iowan Old Style",Charter,"Times New Roman",serif;letter-spacing:-.01em;margin:0 0 12px;text-wrap:balance}
p,.para{margin:12px 0}
.eyebrow{display:block;font-size:11px;font-weight:650;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);margin:22px 0 6px}
.pill{display:inline-block;font:600 12px/1.4 system-ui,sans-serif;letter-spacing:.1em;text-transform:uppercase;color:var(--teal);border:1px solid var(--teal);border-radius:3px;padding:1px 8px;margin-right:10px;vertical-align:.2em}
.dek{font-size:20px;line-height:1.45;margin:0 0 6px}
.read{margin-top:8px}.read .para{font-size:17px;line-height:1.6}.read .apart{border-left:2px solid var(--teal);padding-left:16px;margin:14px 0}.read .apart .para{margin-top:0}
.figures{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:14px 0;margin-top:22px;gap:16px}
.figure .eyebrow{margin:0 0 2px}.figure strong{display:block;font-size:26px;font-weight:600;line-height:1.15;font-variant-numeric:tabular-nums}.figure small{display:block;font-size:11px;color:var(--faint);margin-top:2px}
.notice{font-size:14px;color:var(--amber);padding:10px 16px;border-left:3px solid var(--amber);background:var(--notice);margin:14px 0}.notice.compact{border:0;background:none;padding:0;margin:8px 0 0;font-size:13px}
.fine{font-size:14px;color:var(--muted);margin:6px 0 0}
section{border-top:1px solid var(--line);padding-top:26px;margin-top:40px}
.direction-positive{color:var(--positive)}.direction-negative{color:var(--negative)}.direction-neutral{color:var(--neutral)}
details.cite{display:inline;font-size:13px}details.cite summary{display:inline;list-style:none;cursor:pointer;color:var(--teal);opacity:.7;padding:0 3px;font-size:14px;user-select:none}details.cite summary::-webkit-details-marker{display:none}details.cite summary:hover,details.cite summary:focus,details.cite[open] summary{opacity:1}details.cite .refs{display:block;margin:4px 0 6px;color:var(--muted);line-height:1.5}details.cite .refs a{color:var(--muted);text-decoration-color:var(--line)}details.cite .refs b{color:var(--ink);font-weight:600;font-variant-numeric:tabular-nums}
.since{margin-top:34px}.since h2{font-size:20px;margin-bottom:6px}.since ul{margin:6px 0;padding-left:20px}.since li{margin:6px 0}
.watch{border-top:1px solid var(--rule);padding:12px 0 4px;margin:0}.watch:first-of-type{border-top:0;padding-top:4px}
.watch .question{font-size:17px;line-height:1.4;font-weight:600;margin:0 0 6px}.watch .horizon{display:inline-block;font-size:12px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:var(--muted);margin-left:10px;white-space:nowrap}
.tests{display:grid;grid-template-columns:max-content 1fr;gap:3px 14px;margin:0 0 6px;font-size:15px;line-height:1.5}.tests dt{font-size:11px;font-weight:650;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);margin:0;padding-top:4px}.tests dd{margin:0}
.flags,.events{list-style:none;padding:0;margin:4px 0 0}.flags li,.events li{padding:7px 0;border-top:1px solid var(--rule);font-size:15px;line-height:1.45}.flags li:first-child,.events li:first-child{border-top:0}.flags b,.events b{font-weight:600;margin-right:6px}.flags small,.events small{color:var(--faint);font-size:12px;margin-left:6px;white-space:nowrap}
.caption{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;align-items:baseline;font-size:11px;font-weight:650;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);margin:22px 0 6px}.caption span{font-weight:500;letter-spacing:.06em;text-transform:none;color:var(--faint)}
table{width:100%;border-collapse:collapse;font-size:15px;table-layout:fixed}th{text-align:left;font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);font-weight:600;padding:6px 8px;border-bottom:1px solid var(--line)}td{padding:9px 8px;border-bottom:1px solid var(--rule);vertical-align:top;overflow-wrap:anywhere}th:first-child{width:34%}table.narrow-first th:first-child{width:22%}th.number,td.number{text-align:right}td.number{font-variant-numeric:tabular-nums}td.primary{font-size:17px;font-weight:700}td.secondary{font-size:13.5px;color:var(--muted);opacity:.85}td small,td .ticker{display:block;font-size:12px;color:var(--faint);font-weight:400}td .ticker{display:inline;margin-left:6px;letter-spacing:.04em}td b{font-weight:600}
.ledger-link{font-size:12px;color:var(--faint);margin:6px 0 0}.ledger-link a{color:var(--faint)}
.mobile-detail{display:none}
.context-status{display:flex;align-items:baseline;gap:9px;font-size:12px;color:var(--muted);margin-bottom:5px}.context-status strong{color:var(--teal);font-size:11px;letter-spacing:.12em}
details.drawer{border-top:1px solid var(--line);padding:13px 0;font-size:13px}details.drawer summary{cursor:pointer;font-weight:650}.sources{padding-left:20px}.sources li{margin:10px 0}.ledger-group{margin:12px 0 4px;font-weight:650}.ledger{padding:9px 0 9px 12px;border-bottom:1px solid var(--rule);overflow-wrap:anywhere;color:var(--muted)}.ledger b{color:var(--ink)}
footer{display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;align-items:center;font-size:12px;color:var(--muted);margin-top:36px;border-top:1px solid var(--line);padding-top:12px}
.theme-control{display:flex;align-items:center;gap:7px;font-size:11px;letter-spacing:.06em}.theme-control label{color:var(--faint)}.theme-control select{appearance:none;border:1px solid var(--line);border-radius:3px;background:var(--paper);color:var(--ink);font:inherit;padding:3px 18px 3px 7px}
@media(max-width:600px){main{padding:22px 18px 34px}body{font-size:16.5px;line-height:1.55}h1{font-size:38px;line-height:1.08;margin:16px 0 14px}h2{font-size:22px}.dek{font-size:18px}.read .para{font-size:16.5px}.figures{gap:10px;padding:12px 0}.figure strong{font-size:22px}.figure .eyebrow{font-size:10px;letter-spacing:.08em}.tests{font-size:14.5px}.watch .horizon{display:block;margin:2px 0 0;white-space:normal}table{font-size:14px}td,th{padding:7px 5px}td.primary{font-size:15.5px}th:first-child{width:50%}table.narrow-first th:first-child{width:28%}td.number{overflow-wrap:normal}.secondary{display:none}.mobile-detail{display:block;font-size:12px;color:var(--faint);font-weight:400;margin-top:1px}.masthead{font-size:10px}section{margin-top:32px;padding-top:22px}}
@media print{body{background:white}a{color:inherit}details{display:block}section,.watch,tr{break-inside:avoid}h1{font-size:34px}.theme-control{display:none}}
</style></head><body><main>
{% macro marker(refs) -%}{% if refs %}<details class="cite"><summary aria-label="Supporting evidence" title="Supporting evidence">§</summary><span class="refs">{% for r in refs %}{% if r.anchor %}<a href="#evidence-{{ r.id }}">{{ r.label }}{% if r.display %} <b>{{ r.display }}</b>{% endif %}</a>{% else %}{{ r.label }}{% if r.display %} <b>{{ r.display }}</b>{% endif %}{% endif %}{% if not loop.last %} · {% endif %}{% endfor %}</span></details>{% endif %}{%- endmacro %}
{% macro paragraph(p) -%}<div class="para">{{ p.text }} {{ marker(p.refs) }}</div>{% if p.context %}<p class="fine">{{ p.context }}</p>{% endif %}{%- endmacro %}
{% macro numcell(c, klass='', dated=false) -%}<td class="number {{ klass }} direction-{{ c.direction }}">{{ c.display }}{% if dated and c.observed %}<small>{{ c.observed }}</small>{% endif %}</td>{%- endmacro %}
{% macro instrument_table(rows, change_label, change_head, first_label, relative_label, asof, show_ticker, primary) -%}
<table><thead><tr><th>{{ first_label }}</th>{% if relative_label %}<th class="number">{{ relative_label }}</th>{% endif %}<th class="number">{{ change_head }}</th><th class="number secondary">20D</th><th class="number secondary">vs 50DMA</th></tr></thead><tbody>
{% for row in rows %}<tr><td><b>{{ row.label }}</b>{% if show_ticker and row.label != row.symbol %}<span class="ticker">{{ row.symbol }}</span>{% endif %}<span class="mobile-detail">20D {{ row.r20.display|replace(' %', '%') }} · 50DMA {{ row.dma.display|replace(' %', '%') }}</span></td>{% if relative_label %}{{ numcell(row.relative, 'primary' if primary == 'relative' else '') }}{% endif %}{{ numcell(row.today, 'primary' if primary == 'today' else '', true) }}{{ numcell(row.r20, 'secondary') }}{{ numcell(row.dma, 'secondary') }}</tr>
{% endfor %}</tbody></table>
{%- endmacro %}
{% macro ledger_link() -%}<p class="ledger-link"><a href="#evidence-ledger">Every cell is a ledger row · open the evidence ledger</a></p>{%- endmacro %}
<div class="masthead"><b class="masthead-title">Market Brief</b><span>{{ edition_label }}</span></div>
<div class="status-line">{{ status_line }}</div>
{% if truth %}<div class="notice">{{ truth }}</div>{% endif %}
<h1>{{ banner.title }}</h1>
<div class="dek"><span class="pill">{{ banner.label }}</span>{{ character }} {{ marker(character_refs) }}</div>
<div class="read">{% for p in summary %}<div class="entry{% if not loop.first %} apart{% endif %}">{{ paragraph(p) }}</div>{% endfor %}</div>
{% if figures %}<div class="figures">{% for f in figures %}<div class="figure"><span class="eyebrow">{{ f.topic }} · {{ f.metric_label }}</span><strong class="direction-{{ f.direction }}">{{ f.display }}</strong><small>{{ f.observed_short }}{% if f.status == 'PROVISIONAL' %} · PROVISIONAL{% endif %}</small></div>{% endfor %}</div>{% endif %}
{% if coverage.missing_domains %}<p class="notice compact">Missing: {{ coverage.missing_domains|join(' · ') }}.</p>{% endif %}
{% if since.label %}<div class="since"><h2>{{ since.label }}</h2>{% if since.entries %}<ul>{% for item in since.entries %}<li>{% if item.kind == 'change' %}{{ item.text }}{% else %}{{ item.text }} <b>— {{ item.assessment }}.</b> {{ item.reason }}{% endif %} {{ marker(item.refs) }}</li>{% endfor %}</ul>{% endif %}{% if since.note %}<p class="fine">{{ since.note }}</p>{% endif %}</div>{% endif %}
<section class="next"><h2>What matters next</h2>
{% if since.note and not since.label %}<p class="fine">{{ since.note }}</p>{% endif %}
{% for p in next.paragraphs %}{{ paragraph(p) }}{% endfor %}
{% if next.watches or next.carried %}<span class="eyebrow">Watches</span>{% endif %}
{% for w in next.watches %}<div class="watch"><div class="question">{{ w.condition }} {{ marker(w.refs) }}<span class="horizon">{{ w.phrase }}</span></div><dl class="tests"><dt>Confirm</dt><dd>{{ w.confirmation }}</dd>{% if w.contradiction %}<dt>Changes it</dt><dd>{{ w.contradiction }}</dd>{% endif %}</dl></div>{% endfor %}
{% for c in next.carried %}<div class="watch"><div class="question">{{ c.hypothesis }} {{ marker(c.refs) }}<span class="horizon">Carried watch · {{ c.assessment }}{% if c.lifecycle == 'expired' %} · horizon passed{% endif %}</span></div>{% if c.reason %}<p class="fine">{{ c.reason }}</p>{% endif %}</div>{% endfor %}
{% if next.attention %}<span class="eyebrow">Flagged</span><ul class="flags">{% for a in next.attention %}<li><b>{{ a.display_symbol }}</b>{{ a.reason }}. {{ a.why }}<small>{{ a.date_label }}</small> {{ marker(a.refs) }}</li>{% endfor %}</ul>{% endif %}
{% if next.events %}<span class="eyebrow">Events</span><ul class="events">{% for event in next.events %}<li><b>{{ event.title }}</b>{{ event.scheduled_label }} · {{ event.relation_label }} {{ marker(event.refs) }}</li>{% endfor %}</ul>{% endif %}
</section>
{% if equities.paragraphs or equities.rows %}<section><h2>Equity structure</h2>
{% for p in equities.paragraphs %}{{ paragraph(p) }}{% endfor %}
{% if equities.rows %}<div class="caption">Mega-cap snapshot<span>{{ equities.change_label }}{% if equities.asof %} · {{ equities.asof }}{% endif %}</span></div>{{ instrument_table(equities.rows, equities.change_label, equities.change_head, 'Symbol', 'vs QQQ · 20s', equities.asof, false, 'relative') }}{{ ledger_link() }}{% endif %}
{% for symbol, state in equities.lookback.items() %}<p class="fine">{{ symbol }} 20s: n/a ({{ state.sessions }} sessions)</p>{% endfor %}
</section>{% endif %}
{% if macro.paragraphs or macro.yields or macro.facts %}<section><h2>Macro &amp; rates</h2>
{% for p in macro.paragraphs %}{{ paragraph(p) }}{% endfor %}
{% if macro.yields %}<div class="caption">Treasury par yields<span>{% if macro.yields_asof %}{{ macro.yields_asof }} · {% endif %}daily par curve, not an intraday quote</span></div><table class="narrow-first"><thead><tr><th>Maturity</th><th class="number">Yield</th><th class="number">Daily change</th>{% if not macro.yields_asof %}<th>Date</th>{% endif %}</tr></thead><tbody>{% for row in macro.yields %}<tr><td><b>{{ row.maturity }}</b></td>{{ numcell(row.level, 'primary') }}<td class="number direction-{{ row.change.direction }}">{{ row.change.display }}{% if row.change_note %}<small>{{ row.change_note }}</small>{% endif %}</td>{% if not macro.yields_asof %}<td><small>{{ row.date }}</small></td>{% endif %}</tr>{% endfor %}</tbody></table>{{ ledger_link() }}{% endif %}
{% if macro.facts %}<div class="caption">Observed</div><table><thead><tr><th>Measure</th><th class="number">Observation</th><th>Date / source</th></tr></thead><tbody>{% for row in macro.facts %}<tr><td>{{ row.measure }}</td><td class="number primary direction-{{ row.direction }}">{{ row.display }}</td><td><small>{{ row.observed_label }} · {{ row.status }}</small></td></tr>{% endfor %}</tbody></table>{{ ledger_link() }}{% endif %}
</section>{% endif %}
{% if sectors.rows %}<section><h2>Sector view</h2><div class="caption">{{ sectors.spread_label }}{% if sectors.asof %} · {{ sectors.asof }}{% endif %}<span>{{ sectors.change_label }}</span></div>{{ instrument_table(sectors.rows, sectors.change_label, sectors.change_head, 'Sector', 'vs SPY · 20s', sectors.asof, true, 'relative') }}{{ ledger_link() }}</section>{% endif %}
{% if cross_asset.rows %}<section><h2>Cross-asset structure</h2><div class="caption">Metals structure<span>{{ cross_asset.change_label }}{% if cross_asset.asof %} · {{ cross_asset.asof }}{% endif %} · {% for row in cross_asset.rows %}{{ row.symbol }} vs {{ row.relative_label }}{% if not loop.last %}, {% endif %}{% endfor %}</span></div>{{ instrument_table(cross_asset.rows, cross_asset.change_label, cross_asset.change_head, 'Instrument', 'Spread · 20s', cross_asset.asof, true, 'today') }}{{ ledger_link() }}</section>{% endif %}
{% if cuttingboard_section.visible %}<section><h2>Cuttingboard context</h2>{% for p in cuttingboard_section.paragraphs %}{{ paragraph(p) }}{% endfor %}
{% if cuttingboard.status == 'AVAILABLE' %}<div class="context-status"><strong>{{ cuttingboard.status }}</strong><span>Outcome {{ cuttingboard.outcome or 'not exposed' }} · permission {{ cuttingboard.permission or 'not exposed' }}</span></div><p class="fine">Read-only context captured; see Technical details.</p>
{% else %}<div class="context-status"><strong>{{ cuttingboard.status }}</strong><span>Optional context</span></div><p class="fine">{{ cuttingboard.reason }}</p>{% endif %}</section>{% endif %}
<section><h2>Sources &amp; coverage</h2><p class="fine">{{ coverage.basis }}. {{ coverage.horizon }}</p>
<div class="fine">{{ banner.limitation }} {{ marker(banner.refs) }}</div>
<details class="drawer"><summary>Coverage limitations</summary><ul>{% for item in limitations %}<li>{{ item }}</li>{% endfor %}</ul></details>
<details class="drawer"><summary>Source ledger · {{ sources|length }} checked or declared sources</summary><ul class="sources">{% for s in sources %}<li><a href="{{ s.url }}">{{ s.name }}</a> · {{ s.kind }} · {{ s.status }}<br>Retrieved {{ s.retrieved_at }}{% if s.reason %} · {{ s.reason }}{% endif %}</li>{% endfor %}</ul></details>
<details class="drawer" id="evidence-ledger"><summary>Evidence ledger · exact values and baselines</summary>{% for group in evidence_groups %}<div class="ledger-group">{{ group.topic }}</div>{% for row in group.rows %}<div class="ledger" id="evidence-{{ row.id }}"><b>{{ row.id }}</b> · {{ row.display }} · {{ row.baseline or 'Published / scheduled item' }} · observed / published {{ row.observed_at or row.published_at or 'not exposed' }} · source {{ row.source_id }}</div>{% endfor %}{% endfor %}</details>
<details class="drawer"><summary>Technical details</summary><ul><li>Generated UTC: {{ technical.generated_utc }}</li><li>Evidence cutoff UTC: {{ technical.evidence_cutoff_utc }}</li><li>Checkpoint: {{ technical.checkpoint }}</li><li>Bootstrap: {{ technical.bootstrap }}</li><li>Calendar: {{ technical.calendar }}</li><li>Continuity: {{ technical.continuity.status }}{% if technical.continuity.reason %} — {{ technical.continuity.reason }}{% endif %}{% if technical.continuity.anchors %} · anchors {% for k, v in technical.continuity.anchors.items() %}{{ k }}={{ v }}{% if not loop.last %}, {% endif %}{% endfor %}{% endif %} · {{ technical.continuity.comparisons }} comparisons, {{ technical.continuity.changed }} changed</li>{% if technical.cuttingboard %}<li>Cuttingboard: generated {{ technical.cuttingboard.generated_at }} · captured {{ technical.cuttingboard.captured_at }} · {{ technical.cuttingboard.schema_version }}</li>{% endif %}{% for provider in technical.providers %}<li>{{ provider.name }}{% if provider.provider %} · {{ provider.provider }}{% endif %}{% if provider.feed %} · {{ provider.feed }}{% endif %}{% if provider.data_delay %} · {{ provider.data_delay }}{% endif %}</li>{% endfor %}</ul></details></section>
<footer><span>Market Brief · Interpretation is model-assisted; observed rows are deterministic. Personal local edition. {% if mode == 'SAMPLE' %}Entire report is a fictional sample.{% endif %}</span><span class="theme-control"><label for="theme-choice">Theme</label><select id="theme-choice" aria-label="Theme"><option value="system">System</option><option value="light">Light</option><option value="dark">Dark</option></select></span></footer>
<script>
(() => {
  const root = document.documentElement;
  const select = document.getElementById('theme-choice');
  const key = 'market-brief-theme';
  let saved = '';
  try { saved = localStorage.getItem(key) || ''; } catch (error) {}
  if (saved === 'light' || saved === 'dark') root.dataset.theme = saved;
  select.value = saved || 'system';
  select.addEventListener('change', () => {
    const value = select.value;
    if (value === 'system') delete root.dataset.theme;
    else root.dataset.theme = value;
    try { localStorage.setItem(key, value); } catch (error) {}
  });
})();
</script>
</main></body></html>
