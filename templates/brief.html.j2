<!doctype html>
<html lang="en" data-session-date="{{ session.date }}" data-checkpoint="{{ marker_checkpoint }}"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'unsafe-inline'; script-src 'unsafe-inline'; base-uri 'none'; form-action 'none'">
<title>{{ banner.title }} · Market Brief</title>
<style>
:root{color-scheme:light dark;--paper:#f6f3ec;--ink:#242e2a;--muted:#627168;--teal:#205e52;--line:#d8ddd3;--amber:#84551a;--notice:#eee6d7;--positive:#2e7654;--negative:#a24942;--neutral:#65736e}
html[data-theme="dark"]{--paper:#20282a;--ink:#f2eadc;--muted:#aab6b1;--teal:#66c7bd;--line:#3d4b4d;--amber:#e1b66d;--notice:#353535;--positive:#7bc994;--negative:#e18179;--neutral:#aab6b1}
@media(prefers-color-scheme:dark){html:not([data-theme]){--paper:#20282a;--ink:#f2eadc;--muted:#aab6b1;--teal:#66c7bd;--line:#3d4b4d;--amber:#e1b66d;--notice:#353535;--positive:#7bc994;--negative:#e18179;--neutral:#aab6b1}}
*{box-sizing:border-box}body{margin:0;background:var(--paper);color:var(--ink);font:16px/1.65 system-ui,sans-serif}
main{max-width:1000px;margin:auto;padding:40px 54px 54px}a{color:var(--teal);text-underline-offset:3px;overflow-wrap:anywhere}
.masthead{display:flex;justify-content:space-between;align-items:center;border-top:4px solid var(--teal);padding-top:13px;font-size:12px;letter-spacing:.13em;text-transform:uppercase;color:var(--teal)}
.masthead-title{font-weight:750}.theme-control{display:flex;align-items:center;gap:7px;font-size:10px;letter-spacing:.1em}.theme-control label{color:var(--muted)}.theme-control select{appearance:none;border:1px solid var(--line);border-radius:3px;background:var(--paper);color:var(--ink);font:inherit;letter-spacing:.08em;padding:4px 20px 4px 7px}
.edition{font-size:12px;color:var(--muted);margin-top:12px;overflow-wrap:anywhere}h1{font:500 48px/1.1 Georgia,serif;letter-spacing:-.03em;max-width:760px;margin:23px 0}
h2{font:600 28px/1.18 Georgia,serif;letter-spacing:-.01em;margin:0 0 16px}h3{font-size:16px;margin-bottom:6px}p{margin:11px 0}.label{font-size:10px;font-weight:750;letter-spacing:.13em;text-transform:uppercase;color:var(--teal)}
.state{display:flex;gap:12px;align-items:baseline;margin:18px 0 7px}.state strong{font-size:21px;letter-spacing:.06em}.lead{font-size:18px;line-height:1.65}
.chips{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:13px 0;margin-top:18px;gap:15px}
.chip strong{display:block;font-size:23px;font-variant-numeric:tabular-nums}.chip small{display:block;font-size:10px;color:var(--muted)}
.notice{font-size:13px;color:var(--amber);padding:11px 16px;border-left:3px solid var(--amber);background:var(--notice);margin:17px 0}.sample{font-weight:650}.coverage{font-size:13px;color:var(--muted);margin:17px 0 22px}
section{border-top:1px solid var(--line);padding-top:23px;margin-top:25px}table{width:100%;border-collapse:collapse;font-size:14px;table-layout:fixed}th{text-align:left;font-size:10px;letter-spacing:.07em;text-transform:uppercase;color:var(--muted);padding:8px 8px;border-bottom:1px solid var(--line)}td{padding:10px 8px;border-bottom:1px solid var(--line);vertical-align:top;overflow-wrap:anywhere}th:first-child{width:43%}th:nth-child(2){width:25%}td.number{font-variant-numeric:tabular-nums;font-weight:700}td small{display:block;font-size:11px;color:var(--muted)}
.direction-positive{color:var(--positive)}.direction-negative{color:var(--negative)}.direction-neutral{color:var(--neutral)}
.cite{display:inline-block;font-size:.72em;line-height:1.25;margin-left:4px;white-space:normal;opacity:.76;text-decoration:none;border-bottom:1px solid currentColor}.cite:hover,.cite:focus{opacity:1;text-decoration:underline}.fine{font-size:13px;color:var(--muted)}.brief-status{margin-top:18px;font-size:12px;color:var(--teal);font-weight:700;letter-spacing:.1em}.edition{line-height:1.6}.basis{font-size:13px;color:var(--muted);border-top:1px solid var(--line);padding-top:12px;margin-top:16px}.notice.compact{margin:11px 0;padding:9px 12px}.watch{border-left:2px solid var(--teal);padding-left:17px;margin:18px 0}.watch p{margin:4px 0}.watch .condition{font-weight:650}.watch-section{border:1px solid var(--line);border-left:3px solid var(--teal);padding:18px 20px 13px;margin-top:23px}.watch-section h2{margin-bottom:10px}.context-section{padding-top:18px;margin-top:20px}.context-section h2{font-size:23px;margin-bottom:10px}.context-status{display:flex;align-items:baseline;gap:9px;font-size:12px;color:var(--muted);margin-bottom:5px}.context-status strong{color:var(--teal);font-size:11px;letter-spacing:.12em}.context-body{margin:0}.context-boundary{margin-top:7px}details{border-top:1px solid var(--line);padding:13px 0;font-size:13px}summary{cursor:pointer;font-weight:650}.sources{padding-left:20px}.sources li{margin:10px 0}.ledger{padding:11px 0;border-bottom:1px solid var(--line);overflow-wrap:anywhere}footer{font-size:11px;color:var(--muted);margin-top:29px}
@media(max-width:600px){main{padding:23px 20px 34px}h1{font-size:35px}h2{font-size:25px}.masthead{font-size:10px}.theme-control{font-size:9px;gap:5px}.theme-control select{font-size:9px;padding:4px 17px 4px 6px}.chips{grid-template-columns:repeat(2,1fr);gap:12px}.lead{font-size:16px}table{font-size:12px}td,th{padding:7px 4px}.chip strong{font-size:21px}th:first-child{width:34%}th:nth-child(2){width:22%}td.number{overflow-wrap:normal}.watch-section{padding:16px 15px 11px;margin-top:20px}}
@media print{body{background:white}a{color:inherit}details{display:block}section,.watch,tr{break-inside:avoid}h1{font-size:34px}.theme-control{display:none}}
</style><style>h1{display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:3;overflow:hidden}</style></head><body><main>
{% macro citations(ids) -%}{% if ids %}<a class="cite" href="#evidence-{{ ids[0] }}" aria-label="Supporting evidence">evidence</a>{% endif %}{%- endmacro %}
{% macro paragraph(p) -%}<p><span class="label">{{ p.class }}</span> {{ p.text }} {{ citations(p.evidence_ids) }}</p>{% if p.context %}<p class="fine">{{ p.context }}</p>{% endif %}{%- endmacro %}
<div class="masthead"><b class="masthead-title">Market Brief</b><span>{{ edition_label }}</span><div class="theme-control"><label for="theme-choice">Theme</label><select id="theme-choice" aria-label="Theme"><option value="system">System</option><option value="light">Light</option><option value="dark">Dark</option></select></div></div>
<div class="brief-status"><span class="label">{{ status }}</span>{% if commissioning %} · COMMISSIONING RUN{% endif %}</div>
{% if status == 'SAMPLE' %}<div class="notice sample">SAMPLE{% if commissioning %} · COMMISSIONING RUN{% else %} · FICTIONAL SAMPLE / REPLAY{% endif %}<br>Generated at {{ updated_label }}. {% if commissioning %}This was a commissioning test, not the scheduled pre-market brief.{% else %}Not current market facts.{% endif %}</div>{% elif live_commissioning %}<div class="notice sample">LIVE COMMISSIONING<br>Collected at {{ updated_label }}{% if phase_phrase %}, {{ phase_phrase }}{% endif %}. This is a current-time commissioning run, not a scheduled checkpoint.</div>{% endif %}
<div class="edition"><strong>{{ header_label }}</strong><br>{% if live_commissioning %}{{ phase_label }} · {% endif %}{{ scheduled_label }}<br>{{ updated_prefix }}: {{ updated_label }}</div>
<h1>{{ banner.title }}</h1><div class="state"><span class="label">Interpretation</span><strong>{{ banner.label }}</strong></div>
<p class="fine">{{ banner.limitation }} {{ citations(banner.evidence_ids) }}</p>
<div class="chips">{% for chip in chips %}<div class="chip"><span class="label">Observed · {{ chip.topic }}</span><strong class="direction-{{ chip.direction }}">{{ chip.display }}</strong><small>{{ chip.metric_label }} · {{ chip.observed_label }} · {{ chip.status }}</small></div>{% endfor %}</div>
<p class="basis">{{ coverage.basis }}.</p>{% if coverage.missing_domains %}<p class="notice compact">Missing: {{ coverage.missing_domains|join(' · ') }}.</p>{% endif %}
<div class="lead">{% for p in summary %}{{ paragraph(p) }}{% endfor %}</div>
<section class="watch-section"><h2>What to watch</h2>{% for w in watches %}<div class="watch"><span class="label">Watch · {{ w.horizon }}</span><p class="condition">{{ w.condition }}</p><p class="fine">Check: {{ w.confirmation }}{% if w.contradiction %} If not: {{ w.contradiction }}{% endif %} {{ citations(w.evidence_ids) }}</p></div>{% endfor %}</section>
{% for section in sections %}<section class="{{ section.key }}-section"><h2>{{ section.title }}</h2>
{% if section.key == 'equities' and section.mega_rows %}<div class="label">Mega-cap snapshot{% if section.mega_asof %} · {{ section.mega_asof }}{% endif %}</div><table><thead><tr><th>Symbol</th><th>Today</th><th>20D</th><th>VS QQQ</th><th>50D AVG</th></tr></thead><tbody>{% for row in section.mega_rows %}<tr><td><b>{{ row.symbol }}</b>{% if row.today.id %}{{ citations([row.today.id]) }}{% endif %}{% if row.label != row.symbol %}<small>{{ row.label }}</small>{% endif %}</td><td class="number direction-{{ row.today.direction }}">{{ row.today.display }}</td><td class="number direction-{{ row.r20.direction }}">{{ row.r20.display }}</td><td class="number direction-{{ row.relative.direction }}">{{ row.relative.display }}</td><td class="number direction-{{ row.average.direction }}">{{ row.average.display }}</td></tr>{% endfor %}</tbody></table>{% endif %}
{% if section.key == 'equities' and section.sector_rows %}<div class="label">Sector snapshot{% if section.sector_asof %} · {{ section.sector_asof }}{% endif %}</div><table><thead><tr><th>Sector</th><th>Today</th><th>20D</th><th>VS SPY</th><th>50D AVG</th></tr></thead><tbody>{% for row in section.sector_rows %}<tr><td><b>{{ row.symbol }} · {{ row.label }}</b>{% if row.today.id %}{{ citations([row.today.id]) }}{% endif %}{% if row.today.observed %}<small>{{ row.today.observed }}</small>{% endif %}</td><td class="number direction-{{ row.today.direction }}">{{ row.today.display }}</td><td class="number direction-{{ row.r20.direction }}">{{ row.r20.display }}</td><td class="number direction-{{ row.relative.direction }}">{{ row.relative.display }}</td><td class="number direction-{{ row.average.direction }}">{{ row.average.display }}</td></tr>{% endfor %}</tbody></table>{% endif %}
{% if section.facts %}<div class="label">Observed</div><table><thead><tr><th>Measure</th><th>Observation</th><th>Date / source</th></tr></thead><tbody>
{% for row in section.facts %}<tr><td>{{ row.measure }}</td><td class="number direction-{{ row.direction }}">{{ row.display }}</td><td><small>{{ row.observed_label }} · {{ row.status }}</small>{{ citations([row.id]) }}</td></tr>{% endfor %}</tbody></table>{% if section.key == 'equities' %}{% for symbol, state in lookback.items() if state.r20 != 'available' %}<p class="fine">{{ symbol }} 20s: n/a ({{ state.sessions }} sessions)</p>{% endfor %}{% endif %}{% endif %}
{% for p in section.paragraphs %}{{ paragraph(p) }}{% endfor %}
{% for a in section.attention %}<h3><span class="label">Observed</span> · {{ a.display_symbol }}</h3><p>{{ a.reason }} {{ a.why }} {{ citations(a.evidence_ids) }}</p><p class="fine">{{ a.date }} · {{ a.horizon }} horizon</p>{% endfor %}
{% for event in section.events %}<p><span class="label">Observed</span> {{ event.title }} — {{ event.scheduled_label }} · {{ event.session_relation }} {{ citations([event.id]) }}</p>{% endfor %}
{% if section.key == 'cuttingboard' %}
{% if cuttingboard.status == 'AVAILABLE' %}<div class="context-status"><strong>{{ cuttingboard.status }}</strong><span>Outcome {{ cuttingboard.outcome or 'not exposed' }} · permission {{ cuttingboard.permission or 'not exposed' }}</span></div><p class="fine context-body">Read-only context captured; see Technical details.</p>
{% else %}<div class="context-status"><strong>{{ cuttingboard.status }}</strong><span>Optional context</span></div><p class="fine context-body">{{ cuttingboard.reason }}</p>{% endif %}
{% endif %}
</section>{% endfor %}
<section><h2>Sources & coverage</h2><details><summary>Coverage limitations</summary><ul>{% for item in limitations %}<li>{{ item }}</li>{% endfor %}</ul></details>
<details><summary>Source ledger · {{ sources|length }} checked or declared sources</summary><ul class="sources">{% for s in sources %}<li><a href="{{ s.url }}">{{ s.name }}</a> · {{ s.kind }} · {{ s.status }}<br>Retrieved {{ s.retrieved_at }}{% if s.reason %} · {{ s.reason }}{% endif %}</li>{% endfor %}</ul></details>
<details><summary>Evidence ledger · exact values and baselines</summary>{% for row in evidence %}<div class="ledger" id="evidence-{{ row.id }}"><b>{{ row.id }}</b> · {{ row.topic or row.title }} · {{ row.display }}<br>{{ row.baseline or 'Published / scheduled item' }}<br>Observed / published {{ row.observed_at or row.published_at or 'not exposed' }} · source {{ row.source_id }}</div>{% endfor %}</details>
<details><summary>Technical details</summary><ul><li>Generated UTC: {{ technical.generated_utc }}</li><li>Evidence cutoff UTC: {{ technical.evidence_cutoff_utc }}</li><li>Checkpoint: {{ technical.checkpoint }}</li><li>Bootstrap: {{ technical.bootstrap }}</li><li>Calendar: {{ technical.calendar }}</li>{% if technical.cuttingboard %}<li>Cuttingboard: generated {{ technical.cuttingboard.generated_at }} · captured {{ technical.cuttingboard.captured_at }} · {{ technical.cuttingboard.schema_version }}</li>{% endif %}{% for provider in technical.providers %}<li>{{ provider.name }}{% if provider.provider %} · {{ provider.provider }}{% endif %}{% if provider.feed %} · {{ provider.feed }}{% endif %}{% if provider.data_delay %} · {{ provider.data_delay }}{% endif %}</li>{% endfor %}</ul></details></section>
<footer>Market Brief · Model-assisted interpretation; factual rows are deterministic. Personal local edition. {% if mode == 'SAMPLE' %}Entire report is a fictional sample.{% endif %}</footer>
<script>
(() => {
  const root = document.documentElement;
  const select = document.getElementById('theme-choice');
  const key = 'market-brief-theme';
  let saved = '';
  try { saved = localStorage.getItem(key) || ''; } catch (error) {}
  if (saved === 'light' || saved === 'dark') root.dataset.theme = saved;
  select.value = saved || 'system';
  select.addEventListener('change', () => {
    const value = select.value;
    if (value === 'system') delete root.dataset.theme;
    else root.dataset.theme = value;
    try { localStorage.setItem(key, value); } catch (error) {}
  });
})();
</script>
</main></body></html>
