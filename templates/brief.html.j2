<!doctype html>
<html lang="en" data-session-date="{{ session.date }}" data-checkpoint="{{ marker_checkpoint }}"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'unsafe-inline'; script-src 'unsafe-inline'; base-uri 'none'; form-action 'none'">
<title>{{ banner.title }} · Market Brief</title>
<style>
:root{color-scheme:light dark;--paper:#f6f3ec;--ink:#242e2a;--muted:#627168;--teal:#205e52;--line:#d8ddd3;--amber:#84551a;--notice:#eee6d7;--positive:#2e7654;--negative:#a24942;--neutral:#65736e}
html[data-theme="dark"]{--paper:#20282a;--ink:#f2eadc;--muted:#aab6b1;--teal:#66c7bd;--line:#3d4b4d;--amber:#e1b66d;--notice:#353535;--positive:#7bc994;--negative:#e18179;--neutral:#aab6b1}
@media(prefers-color-scheme:dark){html:not([data-theme]){--paper:#20282a;--ink:#f2eadc;--muted:#aab6b1;--teal:#66c7bd;--line:#3d4b4d;--amber:#e1b66d;--notice:#353535;--positive:#7bc994;--negative:#e18179;--neutral:#aab6b1}}
*{box-sizing:border-box}body{margin:0;background:var(--paper);color:var(--ink);font:16px/1.65 system-ui,sans-serif}
main{max-width:1000px;margin:auto;padding:40px 54px 54px}a{color:var(--teal);text-underline-offset:3px;overflow-wrap:anywhere}
.masthead{display:flex;justify-content:space-between;align-items:center;border-top:4px solid var(--teal);padding-top:13px;font-size:12px;letter-spacing:.13em;text-transform:uppercase;color:var(--teal)}
.masthead-title{font-weight:750}.theme-control{display:flex;align-items:center;gap:7px;font-size:10px;letter-spacing:.1em}.theme-control label{color:var(--muted)}.theme-control select{appearance:none;border:1px solid var(--line);border-radius:3px;background:var(--paper);color:var(--ink);font:inherit;letter-spacing:.08em;padding:4px 20px 4px 7px}
.status-line{font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--teal);font-weight:700;margin-top:14px;overflow-wrap:anywhere}
h1{font:500 48px/1.1 Georgia,serif;letter-spacing:-.03em;max-width:760px;margin:20px 0 14px;overflow-wrap:anywhere}
h2{font:600 28px/1.18 Georgia,serif;letter-spacing:-.01em;margin:0 0 14px}h3{font-size:16px;margin:16px 0 6px}p{margin:11px 0}.label{font-size:10px;font-weight:750;letter-spacing:.13em;text-transform:uppercase;color:var(--teal)}
.character{display:flex;gap:12px;align-items:baseline;flex-wrap:wrap;margin:0 0 6px}.character strong{font-size:19px;letter-spacing:.06em}.character-text{font-size:17px;line-height:1.55;margin:0 0 4px}.lead{font-size:18px;line-height:1.65}
.chips{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:13px 0;margin-top:18px;gap:15px}
.chip strong{display:block;font-size:23px;font-variant-numeric:tabular-nums}.chip small{display:block;font-size:10px;color:var(--muted)}
.notice{font-size:13px;color:var(--amber);padding:11px 16px;border-left:3px solid var(--amber);background:var(--notice);margin:14px 0}.notice.compact{margin:11px 0;padding:9px 12px}
section{border-top:1px solid var(--line);padding-top:23px;margin-top:25px}table{width:100%;border-collapse:collapse;font-size:14px;table-layout:fixed}th{text-align:left;font-size:10px;letter-spacing:.07em;text-transform:uppercase;color:var(--muted);padding:8px 8px;border-bottom:1px solid var(--line)}td{padding:10px 8px;border-bottom:1px solid var(--line);vertical-align:top;overflow-wrap:anywhere}th:first-child{width:34%}th.number,td.number{text-align:right}td.number{font-variant-numeric:tabular-nums;font-weight:700}td small,td .ticker{display:block;font-size:11px;color:var(--muted);font-weight:400}td .ticker{display:inline;margin-left:6px;letter-spacing:.04em}
.direction-positive{color:var(--positive)}.direction-negative{color:var(--negative)}.direction-neutral{color:var(--neutral)}
.cite{display:inline-block;font-size:.72em;line-height:1.25;margin-left:4px;white-space:normal;opacity:.76;text-decoration:none;border-bottom:1px solid currentColor}.cite:hover,.cite:focus{opacity:1;text-decoration:underline}.fine{font-size:13px;color:var(--muted)}
.since{border-top:1px solid var(--line);padding-top:16px;margin-top:20px}.since h2{font-size:20px;margin-bottom:8px}.since ul{margin:6px 0;padding-left:20px}.since li{margin:6px 0}
.watch-section{border:1px solid var(--line);border-left:3px solid var(--teal);padding:18px 20px 13px;margin-top:23px}.watch-section h2{margin-bottom:10px}.watch{border-left:2px solid var(--teal);padding-left:17px;margin:16px 0}.watch p{margin:4px 0}.watch .condition{font-weight:650}.item{margin:12px 0}.item p{margin:3px 0}
.table-label{font-size:10px;font-weight:750;letter-spacing:.13em;text-transform:uppercase;color:var(--teal);margin:14px 0 4px}
.mobile-detail{display:none}
.context-status{display:flex;align-items:baseline;gap:9px;font-size:12px;color:var(--muted);margin-bottom:5px}.context-status strong{color:var(--teal);font-size:11px;letter-spacing:.12em}
details{border-top:1px solid var(--line);padding:13px 0;font-size:13px}summary{cursor:pointer;font-weight:650}.sources{padding-left:20px}.sources li{margin:10px 0}.ledger{padding:11px 0;border-bottom:1px solid var(--line);overflow-wrap:anywhere}footer{font-size:11px;color:var(--muted);margin-top:29px}
@media(max-width:600px){main{padding:23px 18px 34px}h1{font-size:34px}h2{font-size:24px}.masthead{font-size:10px}.theme-control{font-size:9px;gap:5px}.theme-control select{font-size:9px;padding:4px 17px 4px 6px}.chips{grid-template-columns:repeat(2,1fr);gap:12px}.lead{font-size:16px}.character-text{font-size:16px}table{font-size:12px}td,th{padding:7px 4px}.chip strong{font-size:21px}th:first-child{width:40%}td.number{overflow-wrap:normal}.watch-section{padding:16px 15px 11px;margin-top:20px}.secondary{display:none}.mobile-detail{display:block;font-size:11px;color:var(--muted);font-weight:400}}
@media print{body{background:white}a{color:inherit}details{display:block}section,.watch,tr{break-inside:avoid}h1{font-size:34px}.theme-control{display:none}}
</style></head><body><main>
{% macro citations(ids) -%}{% if ids %}<a class="cite" href="#evidence-{{ ids[0] }}" aria-label="Supporting evidence">evidence</a>{% endif %}{%- endmacro %}
{% macro paragraph(p) -%}<p>{{ p.text }} {{ citations(p.evidence_ids) }}</p>{% if p.context %}<p class="fine">{{ p.context }}</p>{% endif %}{%- endmacro %}
{% macro numcell(c, dated=false) -%}<td class="number direction-{{ c.direction }}">{{ c.display }}{% if dated and c.observed %}<small>{{ c.observed }}</small>{% endif %}</td>{%- endmacro %}
{% macro instrument_table(rows, change_label, first_label, relative_label, asof, show_ticker) -%}
<table><thead><tr><th>{{ first_label }}</th>{% if relative_label %}<th class="number">{{ relative_label }}</th>{% endif %}<th class="number">{{ change_label }}{% if asof %}<br>{{ asof }}{% endif %}</th><th class="number secondary">20D</th><th class="number secondary">vs 50DMA</th></tr></thead><tbody>
{% for row in rows %}<tr><td><b>{{ row.label }}</b>{% if show_ticker and row.label != row.symbol %}<span class="ticker">{{ row.symbol }}</span>{% endif %}{% if row.today.id %}{{ citations([row.today.id]) }}{% endif %}<span class="mobile-detail">20D {{ row.r20.display }} · vs 50DMA {{ row.dma.display }}</span></td>{% if relative_label %}{{ numcell(row.relative) }}{% endif %}{{ numcell(row.today, true) }}<td class="number secondary direction-{{ row.r20.direction }}">{{ row.r20.display }}</td><td class="number secondary direction-{{ row.dma.direction }}">{{ row.dma.display }}</td></tr>
{% endfor %}</tbody></table>
{%- endmacro %}
<div class="masthead"><b class="masthead-title">Market Brief</b><span>{{ edition_label }}</span><div class="theme-control"><label for="theme-choice">Theme</label><select id="theme-choice" aria-label="Theme"><option value="system">System</option><option value="light">Light</option><option value="dark">Dark</option></select></div></div>
<div class="status-line">{{ status_line }}</div>
{% if truth %}<div class="notice">{{ truth }}</div>{% endif %}
<h1>{{ banner.title }}</h1>
<div class="character"><span class="label">Interpretation</span><strong>{{ banner.label }}</strong></div>
<p class="character-text">{{ character }} {{ citations(character_ids) }}</p>
<p class="fine">{{ banner.limitation }} {{ citations(banner.evidence_ids) }}</p>
<div class="lead">{% for p in summary %}{{ paragraph(p) }}{% endfor %}</div>
<div class="chips">{% for chip in chips %}<div class="chip"><span class="label">Observed · {{ chip.topic }}</span><strong class="direction-{{ chip.direction }}">{{ chip.display }}</strong><small>{{ chip.metric_label }} · {{ chip.observed_label }} · {{ chip.status }}</small></div>{% endfor %}</div>
{% if coverage.missing_domains %}<p class="notice compact">Missing: {{ coverage.missing_domains|join(' · ') }}.</p>{% endif %}
{% if since.label or since.note %}<div class="since">{% if since.label %}<h2>{{ since.label }}</h2>{% endif %}{% if since.entries %}<ul>{% for item in since.entries %}<li>{% if item.kind == 'change' %}{{ item.text }}{% else %}{{ item.text }} <b>— {{ item.assessment }}.</b> {{ item.reason }}{% endif %} {{ citations(item.evidence_ids) }}</li>{% endfor %}</ul>{% endif %}{% if since.note %}<p class="fine">{{ since.note }}</p>{% endif %}</div>{% endif %}
<section class="watch-section"><h2>What matters next</h2>
{% for p in next.paragraphs %}{{ paragraph(p) }}{% endfor %}
{% for w in next.watches %}<div class="watch"><span class="label">Watch · {{ w.phrase }}</span><p class="condition">{{ w.condition }}</p><p class="fine">Check: {{ w.confirmation }}{% if w.contradiction %} If not: {{ w.contradiction }}{% endif %} {{ citations(w.evidence_ids) }}</p></div>{% endfor %}
{% for c in next.carried %}<div class="watch"><span class="label">Carried watch · {{ c.assessment }}{% if c.lifecycle == 'expired' %} · horizon passed{% endif %}</span><p class="condition">{{ c.hypothesis }}</p>{% if c.reason %}<p class="fine">{{ c.reason }}</p>{% endif %}</div>{% endfor %}
{% for a in next.attention %}<div class="item"><h3>{{ a.display_symbol }}</h3><p>{{ a.reason }}. {{ a.why }} {{ citations(a.evidence_ids) }}</p><p class="fine">{{ a.date }}</p></div>{% endfor %}
{% for event in next.events %}<div class="item"><p><span class="label">Event</span> {{ event.title }} — {{ event.scheduled_label }} · {{ event.relation_label }} {{ citations([event.id]) }}</p></div>{% endfor %}
</section>
{% if equities.paragraphs or equities.rows %}<section><h2>Equity structure</h2>
{% for p in equities.paragraphs %}{{ paragraph(p) }}{% endfor %}
{% if equities.rows %}<div class="table-label">Mega-cap snapshot</div>{{ instrument_table(equities.rows, equities.change_label, 'Symbol', 'vs QQQ · 20s', equities.asof, false) }}{% endif %}
{% for symbol, state in equities.lookback.items() %}<p class="fine">{{ symbol }} 20s: n/a ({{ state.sessions }} sessions)</p>{% endfor %}
</section>{% endif %}
{% if macro.paragraphs or macro.yields or macro.facts %}<section><h2>Macro &amp; rates</h2>
{% for p in macro.paragraphs %}{{ paragraph(p) }}{% endfor %}
{% if macro.yields %}<div class="table-label">Treasury par yields{% if macro.yields_asof %} · {{ macro.yields_asof }}{% endif %}</div><table><thead><tr><th>Maturity</th><th class="number">Yield</th><th class="number">Daily change</th>{% if not macro.yields_asof %}<th>Date</th>{% endif %}</tr></thead><tbody>{% for row in macro.yields %}<tr><td><b>{{ row.maturity }}</b>{{ citations(row.ids) }}</td>{{ numcell(row.level) }}<td class="number direction-{{ row.change.direction }}">{{ row.change.display }}{% if row.change_note %}<small>{{ row.change_note }}</small>{% endif %}</td>{% if not macro.yields_asof %}<td><small>{{ row.date }}</small></td>{% endif %}</tr>{% endfor %}</tbody></table>{% endif %}
{% if macro.facts %}<div class="table-label">Observed</div><table><thead><tr><th>Measure</th><th class="number">Observation</th><th>Date / source</th></tr></thead><tbody>{% for row in macro.facts %}<tr><td>{{ row.measure }}</td><td class="number direction-{{ row.direction }}">{{ row.display }}</td><td><small>{{ row.observed_label }} · {{ row.status }}</small>{{ citations([row.id]) }}</td></tr>{% endfor %}</tbody></table>{% endif %}
</section>{% endif %}
{% if sectors.rows %}<section><h2>Sector view</h2><p class="fine">{{ sectors.spread_label }}{% if sectors.asof %} · {{ sectors.asof }}{% endif %}</p>{{ instrument_table(sectors.rows, sectors.change_label, 'Sector', 'vs SPY · 20s', sectors.asof, true) }}</section>{% endif %}
{% if cross_asset.rows %}<section><h2>Cross-asset structure</h2>{{ instrument_table(cross_asset.rows, cross_asset.change_label, 'Instrument', 'vs benchmark · 20s', cross_asset.asof, true) }}<p class="fine">{% for row in cross_asset.rows %}{{ row.symbol }} vs {{ row.relative_label }}{% if not loop.last %} · {% endif %}{% endfor %}</p></section>{% endif %}
{% if cuttingboard_section.visible %}<section><h2>Cuttingboard context</h2>{% for p in cuttingboard_section.paragraphs %}{{ paragraph(p) }}{% endfor %}
{% if cuttingboard.status == 'AVAILABLE' %}<div class="context-status"><strong>{{ cuttingboard.status }}</strong><span>Outcome {{ cuttingboard.outcome or 'not exposed' }} · permission {{ cuttingboard.permission or 'not exposed' }}</span></div><p class="fine">Read-only context captured; see Technical details.</p>
{% else %}<div class="context-status"><strong>{{ cuttingboard.status }}</strong><span>Optional context</span></div><p class="fine">{{ cuttingboard.reason }}</p>{% endif %}</section>{% endif %}
<section><h2>Sources &amp; coverage</h2><p class="fine">{{ coverage.basis }}. {{ coverage.horizon }}</p>
<details><summary>Coverage limitations</summary><ul>{% for item in limitations %}<li>{{ item }}</li>{% endfor %}</ul></details>
<details><summary>Source ledger · {{ sources|length }} checked or declared sources</summary><ul class="sources">{% for s in sources %}<li><a href="{{ s.url }}">{{ s.name }}</a> · {{ s.kind }} · {{ s.status }}<br>Retrieved {{ s.retrieved_at }}{% if s.reason %} · {{ s.reason }}{% endif %}</li>{% endfor %}</ul></details>
<details><summary>Evidence ledger · exact values and baselines</summary>{% for row in evidence %}<div class="ledger" id="evidence-{{ row.id }}"><b>{{ row.id }}</b> · {{ row.topic or row.title }} · {{ row.display }}<br>{{ row.baseline or 'Published / scheduled item' }}<br>Observed / published {{ row.observed_at or row.published_at or 'not exposed' }} · source {{ row.source_id }}</div>{% endfor %}</details>
<details><summary>Technical details</summary><ul><li>Generated UTC: {{ technical.generated_utc }}</li><li>Evidence cutoff UTC: {{ technical.evidence_cutoff_utc }}</li><li>Checkpoint: {{ technical.checkpoint }}</li><li>Bootstrap: {{ technical.bootstrap }}</li><li>Calendar: {{ technical.calendar }}</li><li>Continuity: {{ technical.continuity.status }}{% if technical.continuity.reason %} — {{ technical.continuity.reason }}{% endif %}{% if technical.continuity.anchors %} · anchors {% for k, v in technical.continuity.anchors.items() %}{{ k }}={{ v }}{% if not loop.last %}, {% endif %}{% endfor %}{% endif %} · {{ technical.continuity.comparisons }} comparisons, {{ technical.continuity.changed }} changed</li>{% if technical.cuttingboard %}<li>Cuttingboard: generated {{ technical.cuttingboard.generated_at }} · captured {{ technical.cuttingboard.captured_at }} · {{ technical.cuttingboard.schema_version }}</li>{% endif %}{% for provider in technical.providers %}<li>{{ provider.name }}{% if provider.provider %} · {{ provider.provider }}{% endif %}{% if provider.feed %} · {{ provider.feed }}{% endif %}{% if provider.data_delay %} · {{ provider.data_delay }}{% endif %}</li>{% endfor %}</ul></details></section>
<footer>Market Brief · Model-assisted interpretation; factual rows are deterministic. Personal local edition. {% if mode == 'SAMPLE' %}Entire report is a fictional sample.{% endif %}</footer>
<script>
(() => {
  const root = document.documentElement;
  const select = document.getElementById('theme-choice');
  const key = 'market-brief-theme';
  let saved = '';
  try { saved = localStorage.getItem(key) || ''; } catch (error) {}
  if (saved === 'light' || saved === 'dark') root.dataset.theme = saved;
  select.value = saved || 'system';
  select.addEventListener('change', () => {
    const value = select.value;
    if (value === 'system') delete root.dataset.theme;
    else root.dataset.theme = value;
    try { localStorage.setItem(key, value); } catch (error) {}
  });
})();
</script>
</main></body></html>
