<!doctype html>
<html lang="en" data-session-date="{{ session_date }}" data-checkpoint="WEEK_AHEAD" data-evidence-cutoff="{{ evidence_cutoff }}"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'unsafe-inline'; script-src 'unsafe-inline'; base-uri 'none'; form-action 'none'">
<title>{{ title }} · Market Brief week ahead</title>
<style>{{ style|safe }}</style></head><body><main>
{% set cite = namespace(labelled=false) %}
{% macro marker(refs) -%}{% if refs %}<details class="cite"><summary aria-label="Supporting evidence" title="Supporting evidence">{% if not cite.labelled %}{% set cite.labelled = true %}§ evidence{% else %}§{% endif %}</summary><span class="refs">{% for r in refs %}<span class="ref">{% if r.anchor %}<a href="#evidence-{{ r.id }}">{{ r.label }}</a>{% else %}<i>{{ r.label }}</i>{% endif %}<b>{{ r.display }}</b><small>{{ r.when }}</small></span>{% endfor %}<span class="more"><a href="#evidence-ledger">Full evidence ledger</a></span></span></details>{% endif %}{%- endmacro %}
{% macro paragraph(p) -%}<div class="para">{{ p.text }} {{ marker(p.refs) }}</div>{% if p.uncertainty %}<p class="fine">Caveat: {{ p.uncertainty }}</p>{% endif %}{% if p.alternative %}<p class="fine">Could also be: {{ p.alternative }}</p>{% endif %}{%- endmacro %}
<div class="masthead"><span class="masthead-title">Market Brief</span><span>Week ahead · {{ published_on }}</span></div>
{% if sample %}<div class="status-line">Sample · fictional evidence</div>{% elif experiment %}<div class="status-line">Experiment · not published</div>{% endif %}
<dl class="clocks">{% for name, value in clocks %}<div class="clock{% if name == 'Week' %} anchor{% endif %}"><dt>{{ name }}</dt><dd{% if name == 'Next' %} data-next-at="{{ next_at }}"{% endif %}>{{ value }}</dd></div>{% endfor %}</dl>
{% if notice %}<p class="notice"><b>{{ notice }}</b></p>{% endif %}
{% if reconstructed %}<p class="notice">Built from session records reconstructed offline from the archived close artifacts of {{ reconstructed|join(', ') }}: the same projection the close now writes, verified against each run's evidence, handoff and continuity hashes. Not a record written at the close.</p>{% endif %}
<h1>{{ title }}</h1>
<p class="dek">{{ character.text }} {{ marker(character.refs) }}</p>
<span class="eyebrow">{{ week_name }} · {{ week_span }} · {{ label }}</span>
<div class="read">{% for p in summary %}{{ paragraph(p) }}{% endfor %}{% if take %}<div class="apart"><span class="eyebrow">The take</span><div class="para">{{ take.text }} {{ marker(take.refs) }}</div></div>{% endif %}</div>

<section><h2>The week in markets</h2>
{% if bars %}<div class="caption">Week return<span>{{ week_window }}</span></div>
<ul class="bars">{% for b in bars %}<li class="{% if b.anchor %}anchor{% endif %}"><span class="who">{{ b.name if b.name != b.symbol else b.symbol }}{% if b.name != b.symbol %}<small>{{ b.symbol }}</small>{% endif %}</span><span class="track" aria-hidden="true"><span class="bar direction-{{ b.direction }}" style="left:{{ b.left }}%;width:{{ b.width }}%"></span></span><span class="val direction-{{ b.direction }}"><a href="#evidence-{{ b.id }}" class="direction-{{ b.direction }}">{{ b.display }}</a></span></li>{% endfor %}</ul>
<p class="tally"><span>Sectors up on the week: <b>{{ sectors_up }} of {{ sectors }}</b></span>{% for c in cross %}<span>{{ c.symbol }} <b class="direction-{{ c.direction }}">{{ c.display }}</b></span>{% endfor %}</p>
{% else %}<p class="notice compact">{{ week_missing }}</p>{% endif %}
{% for p in sections.equities %}{{ paragraph(p) }}{% endfor %}
<div class="caption">Day by day<span>session records</span></div>
<table class="strip"><thead><tr><th></th>{% for d in strip_days %}<th>{{ d.weekday }}<br>{{ d.day }}</th>{% endfor %}{% if bars %}<th>Week</th>{% endif %}</tr></thead><tbody>{% for line in strip %}<tr><td><b>{{ line.symbol }}</b></td>{% for c in line.cells %}<td class="{% if c.absent %}absent{% else %}direction-{{ c.direction }}{% endif %}">{{ c.display }}</td>{% endfor %}{% if bars %}<td class="direction-{{ line.week.direction }}"><b>{{ line.week.display }}</b></td>{% endif %}</tr>{% endfor %}</tbody></table>
<p class="fine">{{ strip_note }}</p>
</section>

<section><h2>What the week tested</h2>
{% if relationships %}<span class="eyebrow">What held up</span><ul class="trail">{% for r in relationships %}<li>{{ r.statement }} {{ marker(r.refs) }}<span class="end">{{ r.instruments }}</span></li>{% endfor %}</ul>{% endif %}
{% if trail %}<span class="eyebrow">Relationships the dailies carried</span><ul class="trail">{% for t in trail %}<li>{{ t.statement }}<span class="steps">{% for s in t.steps %}<span class="step s-{{ s.status }}">{{ s.day }} · {{ s.word }}</span>{% endfor %}</span><span class="end">Last: {{ t.last }}</span></li>{% endfor %}</ul>{% endif %}
<p class="tally"><span>Watches written this week: <b>{{ watches_written }}</b></span>{% for name, count in tally %}<span>{{ name|capitalize }} <b>{{ count }}</b></span>{% endfor %}</p>
<p class="fine">Watches and relationships are the daily analyst's hypotheses with their same-session verdicts, as written at the time: interpretation, not evidence.</p>
<details class="drawer"><summary>The week's earlier reads <span>· {{ reads|length }} sessions</span></summary><ul class="reads">{% for r in reads %}<li><span class="label">{{ r.day }}</span>{% if r.read %}<b>{{ r.read.label }}</b> · {{ r.read.character }} <small>({{ r.read.checkpoint|replace('_', ' ')|lower }})</small>{% else %}<small>no accepted analysis that session</small>{% endif %}{% if r.watches %}<ul>{% for w in r.watches %}<li>{{ w.hypothesis }} <small>· {{ w.end }}{% if w.verdicts %} · {{ w.verdicts }}{% endif %}</small></li>{% endfor %}</ul>{% endif %}</li>{% endfor %}</ul></details>
</section>

<section><h2>Rates &amp; cross-asset</h2>
{% for p in sections.macro %}{{ paragraph(p) }}{% endfor %}
<div class="caption">The week's path<span>Treasury par curve</span></div>
<table class="path narrow-first rates"><thead><tr><th>Maturity</th><th class="number">Start</th><th class="number">End</th><th class="number">Change</th></tr></thead><tbody>{% for r in path %}<tr><td><b>{{ r.label }}</b></td><td class="number">{{ r.start }}<small>{{ r.start_date }}</small></td><td class="number primary">{{ r.end }}<small>{{ r.end_date }}</small></td><td class="number direction-{{ r.direction }}">{{ r.change }}</td></tr>{% endfor %}</tbody></table>
<p class="fine">{{ path_note }}</p>
{% if panel %}{% set rp = panel %}<div class="rates-panel" id="rates-context"><div class="caption">{{ rp.title }}<span>{{ rp.caption }}</span></div>{% if rp.rows %}<table class="horizons"><thead><tr><th rowspan="2">Maturity</th><th class="number" rowspan="2">Yield</th><th class="number span" colspan="3">Change, bp, over</th></tr><tr><th class="number">1 day</th><th class="number">5 days</th><th class="number">20 days</th></tr></thead><tbody>{% for row in rp.rows %}<tr><td><b>{{ row.maturity }}</b></td><td class="number">{{ row.level }}</td>{% for m in row.moves %}<td class="number{% if m.absent %} absent{% endif %}">{{ m.display }}</td>{% endfor %}</tr>{% endfor %}</tbody></table><p class="fine unit-note">Days are Treasury's own daily entries: each change is against the official entry 1, 5 or 20 entries earlier.</p>{% endif %}
{% if rp.chart %}{% set ch = rp.chart %}<figure class="rates-chart"><svg width="100%" height="{{ ch.height }}" role="img" aria-label="{{ ch.summary }}">{% for line in ch.lines %}<g class="series s-{{ line.tenor|lower }}">{% for g in line.segments %}<line x1="{{ g.x1 }}" y1="{{ g.y1 }}" x2="{{ g.x2 }}" y2="{{ g.y2 }}" vector-effect="non-scaling-stroke"/>{% endfor %}{% if line.end %}<circle cx="{{ line.end.x }}" cy="{{ line.end.y }}" r="3"/><text x="{{ line.end.x }}" dx="6" y="{{ line.end.label_y }}">{{ line.end.label }}</text>{% endif %}</g>{% endfor %}<text class="axis" x="{{ ch.first.x }}" y="{{ ch.label_y }}">{{ ch.first.text }}</text><text class="axis" x="{{ ch.last.x }}" y="{{ ch.label_y }}" text-anchor="end">{{ ch.last.text }}</text></svg><figcaption>{{ ch.summary }}</figcaption></figure>{% endif %}
<dl class="rates-facts">{% if rp.spreads %}<dt>Spreads</dt><dd>{{ rp.spreads|join(' · ') }}</dd>{% endif %}{% if rp.leaders %}<dt>Front vs long end</dt><dd>{% for l in rp.leaders %}<span>{{ l.horizon }}: {{ l.text }} ({{ l.detail }})</span>{% endfor %}</dd>{% endif %}{% if rp.parts %}<dt>10Y nominal vs real</dt><dd>{% for part in rp.parts %}<span>{{ part.horizon }}: {{ part.text }}</span>{% endfor %}</dd>{% endif %}{% if rp.volatility %}<dt>10Y volatility</dt><dd>{{ rp.volatility.text }}<small>{{ rp.volatility.explainer }}</small></dd>{% endif %}{% if rp.funding %}{% set f = rp.funding %}<dt>Overnight funding</dt><dd>{% for r in f.rows %}<span><b>{{ r.name }}</b> {{ r.level }}{% if r.date %} on {{ r.date }}{% endif %}{% if r.change %} · {{ r.change }}{% endif %}{% if r.revised %} · revised by the New York Fed{% endif %}</span>{% endfor %}{% if f.spread %}<span>{{ f.spread.text }}</span>{% endif %}{% if f.target %}<span>{{ f.target }}</span>{% endif %}{% if f.trend %}<small>{{ f.trend }}</small>{% endif %}<small>{{ f.explainer }}</small></dd>{% endif %}</dl>{% for note in rp.notes %}<p class="fine">{{ note }}</p>{% endfor %}{% if rp.caveat %}<p class="fine">{{ rp.caveat }}</p>{% endif %}</div>{% endif %}
</section>

<section class="next"><h2>Next week</h2>
{% for p in sections.events %}{{ paragraph(p) }}{% endfor %}
<ul class="calendar">{% for d in calendar %}<li><span class="day"><b>{{ d.day }}</b><span class="hours{% if not d.open or d.early %} closed{% endif %}">{{ d.hours }}</span></span>{% if d.events %}<ul>{% for e in d.events %}<li>{{ e.title }}<small>{{ e.time }} · {{ e.source }}</small></li>{% endfor %}</ul>{% endif %}</li>{% endfor %}</ul>
<p class="fine">Sessions, holidays and early closes are the NYSE calendar's. Releases and company events are listed only when an admitted source scheduled them{% if calendar_note %}; unavailable: {{ calendar_note }}{% endif %}.</p>
<span class="eyebrow">What to watch next week</span>
<p class="fine">{{ carry_caption }}</p>
{% for w in next_watches %}<div class="watch"><p class="question">{{ w.question }} {{ marker(w.refs) }}</p><span class="meta">{{ w.horizon }}</span><dl class="tests"><dt>Confirms</dt><dd>{{ w.confirmation }}</dd><dt>Changes it</dt><dd>{{ w.contradiction }}</dd></dl></div>{% endfor %}
</section>

<section class="audit"><h2>Sources &amp; coverage</h2>
{% if limitation %}<div class="fine">{{ limitation }} {{ marker(banner_refs) }}</div>{% endif %}
{% if limitations %}<details class="drawer" open><summary>Coverage limitations <span>· {{ limitations|length }}</span></summary><ul>{% for item in limitations %}<li>{{ item }}</li>{% endfor %}</ul></details>{% endif %}
<details class="drawer"><summary>Sources · {{ sources|length + 1 }}</summary><ul class="sources"><li><span class="source-name">{{ restore.name }}</span><span class="source-status">{{ restore.status_label }}</span><small>{{ restore.detail }}</small></li>{% for s in sources %}<li><span class="source-name"><a href="{{ s.url }}">{{ s.name }}</a>{% if s.kind_label %} <span>· {{ s.kind_label }}</span>{% endif %}</span><span class="source-status{% if s.unavailable %} unavailable{% elif s.degraded %} degraded{% endif %}">{{ s.status_label }}{% if (s.unavailable or s.degraded) and s.reason %} · {{ s.reason }}{% endif %}</span>{% if s.detail or s.retrieved %}<small>{{ s.detail }}{% if s.detail and s.retrieved %} · {% endif %}{% if s.retrieved %}checked {{ s.retrieved }}{% endif %}</small>{% endif %}</li>{% endfor %}{% for s in archived_sources %}<li><span class="source-name"><a href="{{ s.url }}">{{ s.name }}</a></span><span class="source-status">From session records</span><small>not collected this run; attributed from the records' archived source descriptor</small></li>{% endfor %}</ul></details>
<details class="drawer" id="evidence-ledger"><summary>Evidence ledger <span>· {{ ledger|length }} rows shown · {{ archived_count }} archived rows admitted{% if withheld_count %} · {{ withheld_count }} withheld{% endif %}</span></summary>{% for row in ledger %}<div class="ledger" id="evidence-{{ row.id }}"><span>{{ row.label }}</span><span class="value">{{ row.display }}</span><span class="when">{{ row.when }}</span><small>{{ row.baseline }} · {{ row.source }}{% if row.record %} · {{ row.record }}{% endif %} · <span class="rid">{{ row.id }}</span></small></div>{% endfor %}</details>
<details class="drawer"><summary>Technical details</summary><ul><li>Run: {{ technical.run_id }} · evidence cutoff {{ technical.cutoff }}</li><li>Interpretation: week ahead · run {{ technical.interpretation }}</li>{% for day, r in technical.records.items() %}<li>Session record {{ day }}: run {{ r.run_id }} · hash {{ r.content_hash[:12] }}{% if r.workflow_run_id %} · workflow run {{ r.workflow_run_id }}{% endif %}{% if r.written_by != 'close' %} · {{ r.written_by }}{% endif %}</li>{% endfor %}{% for day in technical.missing %}<li>Session record {{ day }}: none accepted</li>{% endfor %}<li>Continuity: isolated; this edition neither reads nor advances session continuity</li>{% if technical.repairs %}<li>Citations rewritten: {{ technical.repairs|join('; ') }}</li>{% endif %}</ul></details></section>
<footer><span>Market Brief · Week ahead · Interpretation is model-assisted; observed rows are deterministic.{% if sample %} Entire report is a fictional sample.{% endif %}</span><span class="theme-control"><label for="theme-choice">Theme</label><select id="theme-choice" aria-label="Theme"><option value="system">System</option><option value="light">Light</option><option value="dark">Dark</option></select></span></footer>
<script>{{ script|safe }}</script>
</main></body></html>
